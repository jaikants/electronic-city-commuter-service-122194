# Elastic Beanstalk environment variables and container config for Flask backend
option_settings:
  aws:elasticbeanstalk:application:environment:
    FLASK_ENV: "production"
    # Set sensitive secrets in AWS Console (EB env settings/secrets manager), not here!
    # Reference here by key name only if already set securely.
    MONGO_URI: "__MONGO_URI__"        # Replace with your connection string or set in EB web console
    MONGO_DB: "commuter_service"
    JWT_SECRET: "__JWT_SECRET__"      # Set in AWS Elastic Beanstalk environment or use Secrets Manager

# Container-level settings
  aws:elasticbeanstalk:container:python:
    WSGIPath: run.py
    NumProcesses: 3
    NumThreads: 20

# Health check options
  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced

# Security Best Practices:
# 1. Never commit real secrets here. Use EB console or AWS Secrets Manager for production secrets.
# 2. Set only the keys (not values) here if you want them to appear for code reference.
# 3. For Dockerized deploy, use Docker secrets or ECS task definition 'secrets' field.
